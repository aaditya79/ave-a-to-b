# Copy to .env for local runs. Never commit .env.

# Optional. With a Gemini API key the agents call the Gemini API. Without one they call Vertex AI
# with your gcloud credentials (run: gcloud auth application-default login).
GEMINI_API_KEY=

# Vertex AI project, when not using GEMINI_API_KEY. Cloud Run sets this for you.
VERTEXAI_PROJECT=

# Optional, only for rebuilding data with build/: raises NYC Open Data's rate limit.
NYC_OPEN_DATA_APP_TOKEN=
