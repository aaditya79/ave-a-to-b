# Virtual environment. uv recreates it from pyproject.toml + uv.lock.
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Local secrets. Commit .env.example instead, never .env.
.env

# macOS
.DS_Store

# Downloads the build/ scripts can fetch again. Only data/*.parquet ships with the deploy.
data/raw/
cache/
build/cache/

# Local notes and scratch files
.claude/
